import numpy as np
b=range(55,480,5)
v=np.array(b)
n=len(b)
u=np.sqrt(v)
q=n*v
print(q)
s=np.multiply(u,v)
print(s)
t=np.divide(u,v)
print(t)
sumq=np.sum(q,0)
print(sumq)
sums=np.sum(s,0)
print(sums)
sumt=np.sum(t,0)
print(sumt)
print("el vector v tiene", n ,"elementos")
print("la suma de elementos de q es:", sumq)
print("la suma de elementos de s es:", sums)
print("la suma de elementos de t es:", sumt)
