import numpy as np
import matplotlib.pyplot as plt

datos=([12.0,1.92,135.0],[11.1,1.83,121],[10.2,1.76,105.1],[8.9,1.65,81.9],[8.1,1.57,67.5],[7.0,1.47,51.3],[6.0,1.37,36.9],[5.0,1.26,24.3],[4.0,1.15,15.1],[3.0,1.03,7.4])
d=np.array(datos)
V=d[:,0]
I=d[:,1]
Vcon=d[:,2]
R=V/I
Rref=0.6
Tref=293
a=4.5*(10**(-3))

T=((R - Rref)/(a * Rref)) + Tref
x=np.log10(T)
y=np.log10(Vcon)
n,m=np.polyfit(x,y,1)
print(m,n)
yvec=n*x+m

plt.figure()
plt.scatter(x,y,label=f"recta:y={m}x+{n}",color="cyan",linewidths=2)
plt.plot(x,yvec,color="red",linewidth=2)
plt.grid(True)
plt.xlabel("log(T) [K]")
plt.ylabel("log(V) [V]")
plt.savefig("grafica")
plt.show()

